{
  "name": "spasmitflaggen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Geografie-Spiel: Länder über ihre Orte, Landschaften und Rekorde entdecken.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "validate": "tsx tools/validate-data.ts",
    "check": "tsc --noEmit && npm run validate && npm run test",
    "data": "tsx tools/build-data.ts && node tools/build-reveals.mjs && tsx tools/build-generated-facts.ts",
    "data:reference": "node tools/research-wikidata-world.mjs && node tools/build-reference-world.mjs",
    "data:flags": "node tools/download-flags.mjs",
    "data:reveals": "node tools/build-reveals.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew assembleDebug"
  },
  "keywords": [
    "geography",
    "quiz",
    "game",
    "maplibre"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/status-bar": "^7.0.6",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "framer-motion": "^14.9.0",
    "howler": "^2.2.4",
    "i18next": "^26.7.1",
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "shapefile": "^0.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "mapshaper": "^0.7.101",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
